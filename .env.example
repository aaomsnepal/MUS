# ═══════════════════════════════════════════════════════════
#  kkpramod.com.np — live settings
#  server.js reads this file automatically on start.
#
#  KEEP THIS FILE PRIVATE. It holds live payment credentials.
#  Do not commit it to git, do not email it, do not put it in
#  a zip you send to anyone.
# ═══════════════════════════════════════════════════════════

PORT=3002
SITE_PIN=6143
AGENT_KEY=aaoms-print-agent
SITE_URL=https://kkpramod.com.np

# ═══ SAY HI EMAIL NOTIFICATIONS ═════════════════════════════
#  When someone submits the "Say Hi" contact form, the server emails you a
#  copy using the hello@ mailbox. Message always saves to Control Room too —
#  this is just so you also get it straight into Gmail. See EMAIL-SETUP.txt.
SMTP_HOST=mail.kkpramod.com.np
SMTP_PORT=587
SMTP_USER=hello@kkpramod.com.np
SMTP_PASS=
MAIL_TO=aaomsnepal@gmail.com

# ═══ PAYMENTS ═══════════════════════════════════════════════
#  Used ONLY by the Digital Product section of aaomsDigital.
#  Three currencies: NPR (Nepal), INR (India), USD (worldwide).
# ═══════════════════════════════════════════════════════════

# ── INDIA · Razorpay · INR ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ── INTERNATIONAL · PayPal · USD ────────────────────────────
# Works right now with just the handle: buyers pay at
# paypal.me/kkpramod and you release the files from
# Control Room -> Orders.
PAYPAL_ME=kkpramod
# Optional — add these two and USD checkout becomes automatic.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live

# ── NEPAL · NPR ─────────────────────────────────────────────
# Fill whichever you use. Whatever is filled here is shown to
# the buyer at checkout. Buyer pays, presses "I have paid",
# you release the files from Control Room -> Orders.
ESEWA_ID=
KHALTI_ID=
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT=
# Optional: a QR image you have uploaded, e.g. /assets/pay-qr.png
PAYMENT_QR_URL=
